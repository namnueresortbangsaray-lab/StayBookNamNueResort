# Secrets and local configuration
/.env
*.local.json

# .NET
bin/
obj/
*.user
.vs/
TestResults/

# Node / front-end build output
node_modules/
/wwwroot/css/
/wwwroot/js/
/wwwroot/fonts/
/wwwroot/icons.svg

# Runtime data (Docker volumes in production). Anchored: Git on Windows ignores case, and an unanchored
# "storage/" also matched the Helpers/Storage source folder, which was then never committed.
/storage/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Baseline replays (regenerated by tests/baseline/capture.mjs)
/tests/baseline/replay/

# Editors and OS
.idea/
.vscode/
.DS_Store

# Local backups of previous env files
.env.*
!.env.example
