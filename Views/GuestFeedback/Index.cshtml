@using StayBook.Helpers.Extensions
@using StayBook.Services
@model GuestFeedbackViewModel
@{
    ViewData["Title"] = $"{T["ui.guest_feedback.page_title"]} · {T["app_name"]}";
    var action = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var switchCulture = T["ui.guest_feedback.switch_culture"].Value;
    var switchLink = $"{Context.Request.PathBase}{Context.Request.Path}?culture={Uri.EscapeDataString(switchCulture)}";
    string Error(string field) => Model.Errors.TryGetValue(field, out var key) ? T[key].Value : string.Empty;
    var (title, body, tone, iconName) = Model.State switch
    {
        GuestFeedbackState.Submitted => (T["ui.guest_feedback.thanks_title"].Value, T["ui.guest_feedback.thanks_body"].Value, "success", "check"),
        GuestFeedbackState.NotReady => (T["ui.guest_feedback.not_ready_title"].Value, T["ui.guest_feedback.not_ready_body"].Value, "info", "clock"),
        GuestFeedbackState.Expired => (T["ui.guest_feedback.expired_title"].Value, T["ui.guest_feedback.expired_body"].Value.Replace("{date}", Model.ExpiresOn?.ToDisplayDate(), StringComparison.Ordinal), "neutral", "clock"),
        GuestFeedbackState.NotFound => (T["ui.guest_feedback.not_found_title"].Value, T["ui.guest_feedback.not_found_body"].Value, "warning", "warning"),
        _ => (T["ui.guest_feedback.title"].Value, T["ui.guest_feedback.intro"].Value, "primary", "star"),
    };
}
<main id="main" class="guest-shell" tabindex="-1">
  <div class="flex items-center justify-between gap-4">
    <partial name="_Logo" model='"h-12 w-auto"' />
    <a class="btn btn-ghost btn-sm" href="@switchLink" lang="@(switchCulture == "en" ? "en" : "th")" hreflang="@(switchCulture == "en" ? "en" : "th")"><icon name="globe" /><span>@T["ui.guest_feedback.switch_language"]</span></a>
  </div>

  <div class="guest-card">
    @if (Model.State != GuestFeedbackState.Open)
    {
      <div class="flex items-start gap-3">
        <span class="tone-icon tone-@tone" aria-hidden="true"><icon name="@iconName" class="h-5 w-5" /></span>
        <div>
          <h1 class="text-xl font-semibold text-ink">@title</h1>
          <p class="mt-2 text-base text-ink-muted">@body</p>
        </div>
      </div>
      <p class="mt-8 text-sm text-ink-subtle">@T["app_name"] @T["location"]</p>
    }
    else
    {
      <h1 class="text-xl font-semibold text-ink">@title</h1>
      <p class="mt-1 text-base text-ink-muted">@body</p>
      <p class="mt-3 inline-flex items-center gap-2 text-sm text-ink-muted"><icon name="bed" class="h-4 w-4" /><span>@T["ui.guest_feedback.stay"].Value.Replace("{room}", Model.RoomName, StringComparison.Ordinal).Replace("{from}", Model.CheckInDate?.ToDisplayDate(), StringComparison.Ordinal).Replace("{to}", Model.CheckOutDate?.ToDisplayDate(), StringComparison.Ordinal)</span></p>

      @if (Model.Errors.Count > 0)
      {
        <div id="feedback-errors" class="alert tone-danger mt-6" role="alert" tabindex="-1" autofocus>
          <icon name="error" />
          <span>@T["ui.guest_feedback.errors_title"]</span>
        </div>
      }

      <form method="post" action="@action" asp-antiforgery="true" novalidate class="mt-6 space-y-6">
        <p class="text-xs text-ink-subtle">@T["ui.guest_feedback.required_note"]</p>
        @foreach (var field in GuestFeedbackService.RatingKeys)
        {
          var error = Error(field);
          <fieldset class="@(error.Length > 0 ? "fieldset-invalid" : null)" aria-describedby="@field-scale@(error.Length > 0 ? $" {field}-error" : null)">
            <legend class="label">@T[$"ui.guest_feedback.q.{field}"]<span class="req" aria-hidden="true">*</span></legend>
            <div class="rating">
              @for (var n = 1; n <= 5; n++)
              {
                <label class="rating-option">
                  <input class="sr-only" type="radio" name="@field" value="@n" checked="@(Model.Ratings.TryGetValue(field, out var chosen) && chosen == n)">
                  <span aria-hidden="true">@n</span>
                  <span class="sr-only">@T["ui.guest_feedback.score"].Value.Replace("{n}", n.ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal)</span>
                </label>
              }
            </div>
            <p id="@field-scale" class="rating-scale"><span>@T["ui.guest_feedback.scale_low"]</span><span>@T["ui.guest_feedback.scale_high"]</span></p>
            @if (error.Length > 0)
            {
              <p id="@field-error" class="field-error"><icon name="error" /><span>@error</span></p>
            }
          </fieldset>
        }

        @{ var returnError = Error("would_return"); }
        <fieldset class="@(returnError.Length > 0 ? "fieldset-invalid" : null)" aria-describedby="@(returnError.Length > 0 ? "would_return-error" : null)">
          <legend class="label">@T["ui.guest_feedback.would_return"]<span class="req" aria-hidden="true">*</span></legend>
          <div class="grid gap-2 sm:grid-cols-2">
            <label class="check-row"><input class="form-radio" type="radio" name="would_return" value="yes" checked="@(Model.WouldReturn == true)"><span>@T["ui.guest_feedback.yes"]</span></label>
            <label class="check-row"><input class="form-radio" type="radio" name="would_return" value="no" checked="@(Model.WouldReturn == false)"><span>@T["ui.guest_feedback.no"]</span></label>
          </div>
          @if (returnError.Length > 0)
          {
            <p id="would_return-error" class="field-error"><icon name="error" /><span>@returnError</span></p>
          }
        </fieldset>

        @{ var commentError = Error("comment"); }
        <div>
          <label class="label" for="comment">@T["ui.guest_feedback.comment"]</label>
          <textarea id="comment" class="field" name="comment" rows="4" maxlength="@GuestFeedbackService.CommentMaxLength" aria-describedby="comment-hint@(commentError.Length > 0 ? " comment-error" : null)" aria-invalid="@(commentError.Length > 0 ? "true" : null)">@Model.Comment</textarea>
          <p id="comment-hint" class="hint">@T["ui.guest_feedback.comment_hint"]</p>
          @if (commentError.Length > 0)
          {
            <p id="comment-error" class="field-error"><icon name="error" /><span>@commentError</span></p>
          }
        </div>

        <div>
          <button class="btn btn-primary btn-lg w-full" type="submit"><icon name="send" /><span>@T["ui.guest_feedback.submit"]</span></button>
          <p class="mt-3 text-center text-xs text-ink-subtle">@T["ui.guest_feedback.privacy"]</p>
        </div>
      </form>
    }
  </div>
</main>
